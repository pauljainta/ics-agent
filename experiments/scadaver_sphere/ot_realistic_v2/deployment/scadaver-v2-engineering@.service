[Unit]
Description=SCADAver V2 PLC-sourced engineering service %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=researcher
WorkingDirectory=/home/researcher/scadaver-lab
Environment=PYTHONPATH=/home/researcher/scadaver-lab
Environment=SCADAVER_CONTROLLER_HOST=198.18.4.10
Environment=SCADAVER_CONTROLLER_PORT=1502
Environment=SCADAVER_HISTORIAN_DB=/var/lib/scadaver-v2/historian.sqlite
ExecStart=/usr/bin/python3 -m experiments.scadaver_sphere.ot_realistic_v2.engineering_runtime %i
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
