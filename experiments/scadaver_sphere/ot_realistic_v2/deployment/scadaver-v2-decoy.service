[Unit]
Description=SCADAver V2 read-only Modbus decoy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=researcher
WorkingDirectory=/home/researcher/scadaver-lab
Environment=SCADAVER_BIN=/home/researcher/.cargo/bin/scadaver
ExecStart=/home/researcher/scadaver-lab/experiments/scadaver_sphere/node_setup/decoy-service.sh
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
