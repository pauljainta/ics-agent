[Unit]
Description=SCADAver read-only HMI and historian
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=researcher
WorkingDirectory=/home/researcher/scadaver-lab
Environment=SCADAVER_SIMULATOR_HOST=198.18.4.20
Environment=SCADAVER_SIMULATOR_PORT=1503
Environment=SCADAVER_HISTORIAN_DB=/home/researcher/scadaver-state/historian.sqlite
ExecStart=/usr/bin/python3 /home/researcher/scadaver-lab/experiments/scadaver_sphere/node_setup/engineering_runtime.py hmi
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
