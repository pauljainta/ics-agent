    VFD_RAMP_PCT_PER_SCAN : REAL := 1.0;

    (* --- Tank cross-sectional areas ---
       Mass balance is dL[mm] = Q[L/min] * dt[min] / A[m^2], since 1 L/m^2 is
       exactly 1 mm of level. Areas were previously implicit, which silently
       asserted A = 1 m^2 for every tank: ~12x too fast for the raw water tank
       and ~8.8x too slow for the chemical day tanks. Values below are the
