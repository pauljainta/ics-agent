    WQ_MIX_RATE : REAL := 0.001667;
    WQ_DAMAGE_RATE : REAL := 0.000006;

    wq_cl : REAL := 0.0;
    wq_ph : REAL := 7.5;
    wq_cond : REAL := 300.0;
    wq_hard : REAL := 5.0;
    wq_roft_cl : REAL := 0.0;
    wq_perm_cond : REAL := 0.0;
    membrane_damage : REAL := 0.0;
    eff_rejection : REAL := 0.0;
    wq_target : REAL := 0.0;

    (* --- Pump state with delay and speed ramp --- *)
    pump_state : BOOL := FALSE;
    pump_timer : INT := 0;
    pump_actual_speed : REAL := 0.0;
    pump_run_request : BOOL := FALSE;

    (* --- Working variables --- *)
    flow_in : REAL := 0.0;
    flow_out : REAL := 0.0;
    delta_level : REAL := 0.0;
  END_VAR

  (* PLCBench experimental disturbance: an edge initializes source and P2
     chemistry state. The fixture is applied only after a full simulator
     process restart; this does not reset persistent membrane_damage. *)
  IF fixture_apply_pb AND NOT fixture_apply_prev THEN
    IF fixture_case_high_ph THEN
      WQ_SRC_PH := 8.1;
      WQ_SRC_CL := 0.2;
      wq_ph := 8.1;
      wq_cl := 0.2;
    ELSE
      WQ_SRC_PH := 7.5;
      WQ_SRC_CL := 0.0;
      wq_ph := 7.5;
      wq_cl := 0.0;
    END_IF;
    wq_roft_cl := 0.0;
    fixture_active_high_ph := fixture_case_high_ph;
    fixture_apply_ack := NOT fixture_apply_ack;
  END_IF;
  fixture_apply_prev := fixture_apply_pb;

  (* =====================================================================
     1. VALVE DELAY MODELLING
        cmd -> actual position after VALVE_DELAY scans, both directions.
     ===================================================================== *)

  (* Raw water PR (inlet) valve *)
  IF cmd_RW_Tank_PR_Valve AND NOT pr_valve_state THEN
    pr_valve_timer := pr_valve_timer + 1;
    IF pr_valve_timer >= VALVE_DELAY THEN
      pr_valve_state := TRUE;
      pr_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_RW_Tank_PR_Valve AND pr_valve_state THEN
    pr_valve_timer := pr_valve_timer + 1;
    IF pr_valve_timer >= VALVE_DELAY THEN
      pr_valve_state := FALSE;
      pr_valve_timer := 0;
    END_IF;
  ELSE
    pr_valve_timer := 0;
  END_IF;

  (* Raw water P6B (secondary inlet) valve *)
  IF cmd_RW_Tank_P6B_Valve AND NOT p6b_valve_state THEN
    p6b_valve_timer := p6b_valve_timer + 1;
    IF p6b_valve_timer >= VALVE_DELAY THEN
      p6b_valve_state := TRUE;
      p6b_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_RW_Tank_P6B_Valve AND p6b_valve_state THEN
    p6b_valve_timer := p6b_valve_timer + 1;
    IF p6b_valve_timer >= VALVE_DELAY THEN
      p6b_valve_state := FALSE;
      p6b_valve_timer := 0;
    END_IF;
  ELSE
    p6b_valve_timer := 0;
  END_IF;

  (* Raw water P (process outlet) valve *)
  IF cmd_RW_Tank_P_Valve AND NOT p_valve_state THEN
    p_valve_timer := p_valve_timer + 1;
    IF p_valve_timer >= VALVE_DELAY THEN
      p_valve_state := TRUE;
      p_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_RW_Tank_P_Valve AND p_valve_state THEN
    p_valve_timer := p_valve_timer + 1;
    IF p_valve_timer >= VALVE_DELAY THEN
      p_valve_state := FALSE;
      p_valve_timer := 0;
    END_IF;
  ELSE
    p_valve_timer := 0;
  END_IF;

  (* P2 chemical dosing valves - same solenoid delay as the P1 valves *)
  IF cmd_ChemTreat_NaCl_Valve AND NOT nacl_valve_state THEN
    nacl_valve_timer := nacl_valve_timer + 1;
    IF nacl_valve_timer >= VALVE_DELAY THEN
      nacl_valve_state := TRUE;
      nacl_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_ChemTreat_NaCl_Valve AND nacl_valve_state THEN
    nacl_valve_timer := nacl_valve_timer + 1;
    IF nacl_valve_timer >= VALVE_DELAY THEN
      nacl_valve_state := FALSE;
      nacl_valve_timer := 0;
    END_IF;
  ELSE
    nacl_valve_timer := 0;
  END_IF;

  IF cmd_ChemTreat_NaOCl_Valve AND NOT naocl_valve_state THEN
    naocl_valve_timer := naocl_valve_timer + 1;
    IF naocl_valve_timer >= VALVE_DELAY THEN
      naocl_valve_state := TRUE;
      naocl_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_ChemTreat_NaOCl_Valve AND naocl_valve_state THEN
    naocl_valve_timer := naocl_valve_timer + 1;
    IF naocl_valve_timer >= VALVE_DELAY THEN
      naocl_valve_state := FALSE;
      naocl_valve_timer := 0;
    END_IF;
  ELSE
    naocl_valve_timer := 0;
  END_IF;

  IF cmd_ChemTreat_HCl_Valve AND NOT hcl_valve_state THEN
    hcl_valve_timer := hcl_valve_timer + 1;
    IF hcl_valve_timer >= VALVE_DELAY THEN
      hcl_valve_state := TRUE;
      hcl_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_ChemTreat_HCl_Valve AND hcl_valve_state THEN
    hcl_valve_timer := hcl_valve_timer + 1;
    IF hcl_valve_timer >= VALVE_DELAY THEN
      hcl_valve_state := FALSE;
      hcl_valve_timer := 0;
    END_IF;
  ELSE
    hcl_valve_timer := 0;
  END_IF;


  (* P3 ultrafiltration valves - same solenoid delay as P1/P2 *)
  IF cmd_UF_UFFT_Tank_Valve AND NOT ufft_valve_state THEN
    ufft_valve_timer := ufft_valve_timer + 1;
    IF ufft_valve_timer >= VALVE_DELAY THEN
      ufft_valve_state := TRUE;
      ufft_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_UF_UFFT_Tank_Valve AND ufft_valve_state THEN
    ufft_valve_timer := ufft_valve_timer + 1;
    IF ufft_valve_timer >= VALVE_DELAY THEN
      ufft_valve_state := FALSE;
      ufft_valve_timer := 0;
    END_IF;
  ELSE
    ufft_valve_timer := 0;
  END_IF;

  IF cmd_UF_Drain_Valve AND NOT drain_valve_state THEN
    drain_valve_timer := drain_valve_timer + 1;
    IF drain_valve_timer >= VALVE_DELAY THEN
      drain_valve_state := TRUE;
      drain_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_UF_Drain_Valve AND drain_valve_state THEN
    drain_valve_timer := drain_valve_timer + 1;
    IF drain_valve_timer >= VALVE_DELAY THEN
      drain_valve_state := FALSE;
      drain_valve_timer := 0;
    END_IF;
  ELSE
    drain_valve_timer := 0;
  END_IF;

  IF cmd_UF_ROFT_Valve AND NOT roft_valve_state THEN
    roft_valve_timer := roft_valve_timer + 1;
    IF roft_valve_timer >= VALVE_DELAY THEN
      roft_valve_state := TRUE;
      roft_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_UF_ROFT_Valve AND roft_valve_state THEN
    roft_valve_timer := roft_valve_timer + 1;
    IF roft_valve_timer >= VALVE_DELAY THEN
      roft_valve_state := FALSE;
      roft_valve_timer := 0;
    END_IF;
  ELSE
    roft_valve_timer := 0;
  END_IF;

  IF cmd_UF_BWP_Valve AND NOT bwp_valve_state THEN
    bwp_valve_timer := bwp_valve_timer + 1;
    IF bwp_valve_timer >= VALVE_DELAY THEN
      bwp_valve_state := TRUE;
      bwp_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_UF_BWP_Valve AND bwp_valve_state THEN
    bwp_valve_timer := bwp_valve_timer + 1;
    IF bwp_valve_timer >= VALVE_DELAY THEN
      bwp_valve_state := FALSE;
      bwp_valve_timer := 0;
    END_IF;
  ELSE
    bwp_valve_timer := 0;
  END_IF;

  IF cmd_UF_BW_Tank_RO_Valve AND NOT bw_ro_valve_state THEN
    bw_ro_valve_timer := bw_ro_valve_timer + 1;
    IF bw_ro_valve_timer >= VALVE_DELAY THEN
      bw_ro_valve_state := TRUE;
      bw_ro_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_UF_BW_Tank_RO_Valve AND bw_ro_valve_state THEN
    bw_ro_valve_timer := bw_ro_valve_timer + 1;
    IF bw_ro_valve_timer >= VALVE_DELAY THEN
      bw_ro_valve_state := FALSE;
      bw_ro_valve_timer := 0;
    END_IF;
  ELSE
    bw_ro_valve_timer := 0;
  END_IF;

  IF cmd_UF_BW_Tank_PT_Valve AND NOT bw_pt_valve_state THEN
    bw_pt_valve_timer := bw_pt_valve_timer + 1;
    IF bw_pt_valve_timer >= VALVE_DELAY THEN
      bw_pt_valve_state := TRUE;
      bw_pt_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_UF_BW_Tank_PT_Valve AND bw_pt_valve_state THEN
    bw_pt_valve_timer := bw_pt_valve_timer + 1;
    IF bw_pt_valve_timer >= VALVE_DELAY THEN
      bw_pt_valve_state := FALSE;
      bw_pt_valve_timer := 0;
    END_IF;
  ELSE
    bw_pt_valve_timer := 0;
  END_IF;

  IF cmd_DC_ROFT_Tank_Valve AND NOT roft_valve_p4_state THEN
    roft_valve_p4_timer := roft_valve_p4_timer + 1;
    IF roft_valve_p4_timer >= VALVE_DELAY THEN
      roft_valve_p4_state := TRUE;
      roft_valve_p4_timer := 0;
    END_IF;
  ELSIF NOT cmd_DC_ROFT_Tank_Valve AND roft_valve_p4_state THEN
    roft_valve_p4_timer := roft_valve_p4_timer + 1;
    IF roft_valve_p4_timer >= VALVE_DELAY THEN
      roft_valve_p4_state := FALSE;
      roft_valve_p4_timer := 0;
    END_IF;
  ELSE
    roft_valve_p4_timer := 0;
  END_IF;

  IF cmd_DC_NaHSO3_Valve AND NOT nahso3_valve_state THEN
    nahso3_valve_timer := nahso3_valve_timer + 1;
    IF nahso3_valve_timer >= VALVE_DELAY THEN
      nahso3_valve_state := TRUE;
      nahso3_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_DC_NaHSO3_Valve AND nahso3_valve_state THEN
    nahso3_valve_timer := nahso3_valve_timer + 1;
    IF nahso3_valve_timer >= VALVE_DELAY THEN
      nahso3_valve_state := FALSE;
      nahso3_valve_timer := 0;
    END_IF;
  ELSE
    nahso3_valve_timer := 0;
  END_IF;

  (* UV lamp: strikes after a short warm-up, extinguishes immediately *)
  IF cmd_DC_UV_On AND NOT cmd_DC_UV_Off THEN
    IF NOT uv_state THEN
      uv_timer := uv_timer + 1;
      IF uv_timer >= UV_WARMUP_SCANS THEN
        uv_state := TRUE;
        uv_timer := 0;
      END_IF;
    END_IF;
  ELSE
    uv_state := FALSE;
    uv_timer := 0;
  END_IF;

  IF cmd_RO_CF_A_Valve AND NOT cf_a_state THEN
    cf_a_timer := cf_a_timer + 1;
    IF cf_a_timer >= VALVE_DELAY THEN
      cf_a_state := TRUE;
      cf_a_timer := 0;
    END_IF;
  ELSIF NOT cmd_RO_CF_A_Valve AND cf_a_state THEN
    cf_a_timer := cf_a_timer + 1;
    IF cf_a_timer >= VALVE_DELAY THEN
      cf_a_state := FALSE;
      cf_a_timer := 0;
    END_IF;
  ELSE
    cf_a_timer := 0;
  END_IF;

  IF cmd_RO_CF_B_Valve AND NOT cf_b_state THEN
    cf_b_timer := cf_b_timer + 1;
    IF cf_b_timer >= VALVE_DELAY THEN
      cf_b_state := TRUE;
      cf_b_timer := 0;
    END_IF;
  ELSIF NOT cmd_RO_CF_B_Valve AND cf_b_state THEN
    cf_b_timer := cf_b_timer + 1;
    IF cf_b_timer >= VALVE_DELAY THEN
      cf_b_state := FALSE;
      cf_b_timer := 0;
    END_IF;
  ELSE
    cf_b_timer := 0;
  END_IF;

  IF cmd_RO_Tank_Valve AND NOT ro_tank_valve_state THEN
    ro_tank_valve_timer := ro_tank_valve_timer + 1;
    IF ro_tank_valve_timer >= VALVE_DELAY THEN
      ro_tank_valve_state := TRUE;
      ro_tank_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_RO_Tank_Valve AND ro_tank_valve_state THEN
    ro_tank_valve_timer := ro_tank_valve_timer + 1;
    IF ro_tank_valve_timer >= VALVE_DELAY THEN
      ro_tank_valve_state := FALSE;
      ro_tank_valve_timer := 0;
    END_IF;
  ELSE
    ro_tank_valve_timer := 0;
  END_IF;

  IF cmd_PT_RO_Valve AND NOT pt_ro_valve_state THEN
    pt_ro_valve_timer := pt_ro_valve_timer + 1;
    IF pt_ro_valve_timer >= VALVE_DELAY THEN
      pt_ro_valve_state := TRUE;
      pt_ro_valve_timer := 0;
    END_IF;
  ELSIF NOT cmd_PT_RO_Valve AND pt_ro_valve_state THEN
    pt_ro_valve_timer := pt_ro_valve_timer + 1;
    IF pt_ro_valve_timer >= VALVE_DELAY THEN
      pt_ro_valve_state := FALSE;
      pt_ro_valve_timer := 0;
    END_IF;
  ELSE
    pt_ro_valve_timer := 0;
  END_IF;

  IF cmd_PT_PUB_Valve AND NOT pt_pub_state THEN
    pt_pub_timer := pt_pub_timer + 1;
    IF pt_pub_timer >= VALVE_DELAY THEN
      pt_pub_state := TRUE;
      pt_pub_timer := 0;
    END_IF;
  ELSIF NOT cmd_PT_PUB_Valve AND pt_pub_state THEN
    pt_pub_timer := pt_pub_timer + 1;
    IF pt_pub_timer >= VALVE_DELAY THEN
      pt_pub_state := FALSE;
      pt_pub_timer := 0;
    END_IF;
  ELSE
    pt_pub_timer := 0;
  END_IF;

  (* =====================================================================
     2. PUMP DELAY AND SPEED RAMP
        Start dominates only when stop is not asserted.
     ===================================================================== *)

  pump_run_request := cmd_RW_Pump_Start AND NOT cmd_RW_Pump_Stop;

  IF pump_run_request AND NOT pump_state THEN
    pump_timer := pump_timer + 1;
    IF pump_timer >= PUMP_DELAY THEN
      pump_state := TRUE;
      pump_timer := 0;
    END_IF;
  ELSIF NOT pump_run_request AND pump_state THEN
    pump_timer := pump_timer + 1;
    IF pump_timer >= PUMP_DELAY THEN
      pump_state := FALSE;
      pump_timer := 0;
    END_IF;
  ELSE
    pump_timer := 0;
  END_IF;

  (* VFD speed ramp toward the commanded setpoint *)
  IF pump_state THEN
    IF pump_actual_speed < cmd_RW_Pump_Speed THEN
      pump_actual_speed := pump_actual_speed + VFD_RAMP_PCT_PER_SCAN;
      IF pump_actual_speed > cmd_RW_Pump_Speed THEN
        pump_actual_speed := cmd_RW_Pump_Speed;
      END_IF;
    ELSIF pump_actual_speed > cmd_RW_Pump_Speed THEN
      pump_actual_speed := pump_actual_speed - VFD_RAMP_PCT_PER_SCAN;
      IF pump_actual_speed < cmd_RW_Pump_Speed THEN
        pump_actual_speed := cmd_RW_Pump_Speed;
      END_IF;
    END_IF;
  ELSE
    pump_actual_speed := 0.0;
  END_IF;

  (* =====================================================================
     3. FLOW CALCULATION
        Q_pump = (speed / 100) * Q_max, gated on the outlet valve.
     ===================================================================== *)

  IF pump_state AND p_valve_state THEN
    rw_pump_flow := (pump_actual_speed / 100.0) * RW_PUMP_Q_MAX;
  ELSE
    rw_pump_flow := 0.0;
  END_IF;

  (* Backwash pump: same start/stop and ramp treatment as the raw water pump *)
  bw_pump_request := cmd_UF_BW_Pump_Start AND NOT cmd_UF_BW_Pump_Stop;

  IF bw_pump_request AND NOT bw_pump_state THEN
    bw_pump_timer := bw_pump_timer + 1;
    IF bw_pump_timer >= PUMP_DELAY THEN
      bw_pump_state := TRUE;
      bw_pump_timer := 0;
    END_IF;
  ELSIF NOT bw_pump_request AND bw_pump_state THEN
    bw_pump_timer := bw_pump_timer + 1;
    IF bw_pump_timer >= PUMP_DELAY THEN
      bw_pump_state := FALSE;
      bw_pump_timer := 0;
    END_IF;
  ELSE
    bw_pump_timer := 0;
  END_IF;

  IF bw_pump_state THEN
    IF bw_pump_speed < cmd_UF_BW_Pump_Speed THEN
      bw_pump_speed := bw_pump_speed + VFD_RAMP_PCT_PER_SCAN;
      IF bw_pump_speed > cmd_UF_BW_Pump_Speed THEN
        bw_pump_speed := cmd_UF_BW_Pump_Speed;
      END_IF;
    ELSIF bw_pump_speed > cmd_UF_BW_Pump_Speed THEN
      bw_pump_speed := bw_pump_speed - VFD_RAMP_PCT_PER_SCAN;
      IF bw_pump_speed < cmd_UF_BW_Pump_Speed THEN
        bw_pump_speed := cmd_UF_BW_Pump_Speed;
      END_IF;
    END_IF;
  ELSE
    bw_pump_speed := 0.0;
  END_IF;

  (* RO feed pump: same treatment as the other pumps *)
  dc_pump_request := cmd_DC_RO_Pump_Start AND NOT cmd_DC_RO_Pump_Stop;

  IF dc_pump_request AND NOT dc_pump_state THEN
    dc_pump_timer := dc_pump_timer + 1;
    IF dc_pump_timer >= PUMP_DELAY THEN
      dc_pump_state := TRUE;
      dc_pump_timer := 0;
    END_IF;
  ELSIF NOT dc_pump_request AND dc_pump_state THEN
    dc_pump_timer := dc_pump_timer + 1;
    IF dc_pump_timer >= PUMP_DELAY THEN
      dc_pump_state := FALSE;
      dc_pump_timer := 0;
    END_IF;
  ELSE
    dc_pump_timer := 0;
  END_IF;

  IF dc_pump_state THEN
    IF dc_pump_speed < cmd_DC_RO_Pump_Speed THEN
      dc_pump_speed := dc_pump_speed + VFD_RAMP_PCT_PER_SCAN;
      IF dc_pump_speed > cmd_DC_RO_Pump_Speed THEN
        dc_pump_speed := cmd_DC_RO_Pump_Speed;
      END_IF;
    ELSIF dc_pump_speed > cmd_DC_RO_Pump_Speed THEN
      dc_pump_speed := dc_pump_speed - VFD_RAMP_PCT_PER_SCAN;
      IF dc_pump_speed < cmd_DC_RO_Pump_Speed THEN
        dc_pump_speed := cmd_DC_RO_Pump_Speed;
      END_IF;
    END_IF;
  ELSE
    dc_pump_speed := 0.0;
  END_IF;

  IF dc_pump_state AND roft_valve_p4_state AND (roft_tank_level > 0.0) THEN
    dc_pump_flow := (dc_pump_speed / 100.0) * DC_RO_PUMP_Q_MAX;
  ELSE
    dc_pump_flow := 0.0;
  END_IF;

  (* High-pressure RO pump. Feed reaches the membranes only through an open
     cartridge filter; permeate is the recovery fraction of that feed, with the
     remainder leaving as concentrate (not instrumented, not tracked). *)
  ro_pump_request := cmd_RO_Pump_Start AND NOT cmd_RO_Pump_Stop;

  IF ro_pump_request AND NOT ro_pump_state THEN
    ro_pump_timer := ro_pump_timer + 1;
    IF ro_pump_timer >= PUMP_DELAY THEN
      ro_pump_state := TRUE;
      ro_pump_timer := 0;
    END_IF;
  ELSIF NOT ro_pump_request AND ro_pump_state THEN
    ro_pump_timer := ro_pump_timer + 1;
    IF ro_pump_timer >= PUMP_DELAY THEN
      ro_pump_state := FALSE;
      ro_pump_timer := 0;
    END_IF;
  ELSE
    ro_pump_timer := 0;
  END_IF;

  IF ro_pump_state THEN
    IF ro_pump_speed < cmd_RO_Pump_Speed THEN
      ro_pump_speed := ro_pump_speed + VFD_RAMP_PCT_PER_SCAN;
      IF ro_pump_speed > cmd_RO_Pump_Speed THEN
        ro_pump_speed := cmd_RO_Pump_Speed;
      END_IF;
    ELSIF ro_pump_speed > cmd_RO_Pump_Speed THEN
      ro_pump_speed := ro_pump_speed - VFD_RAMP_PCT_PER_SCAN;
      IF ro_pump_speed < cmd_RO_Pump_Speed THEN
        ro_pump_speed := cmd_RO_Pump_Speed;
      END_IF;
    END_IF;
  ELSE
    ro_pump_speed := 0.0;
  END_IF;

  IF ro_pump_state AND (cf_a_state OR cf_b_state) THEN
    ro_pump_flow := (ro_pump_speed / 100.0) * RO_PUMP_Q_MAX;
  ELSE
    ro_pump_flow := 0.0;
  END_IF;
  ro_permeate_flow := ro_pump_flow * RO_RECOVERY;

  (* Flush only actually flows when the backwash permeate valve is open and
     there is water in the tank to draw. *)
  IF bw_pump_state AND bwp_valve_state AND (bw_tank_level > 0.0) THEN
    bw_pump_flow := (bw_pump_speed / 100.0) * BW_PUMP_Q_MAX;
  ELSE
    bw_pump_flow := 0.0;
  END_IF;

  (* =====================================================================
     4. RAW WATER TANK MASS BALANCE
        L[k+1] = L[k] + (Q_in - Q_out) * (dt / 60) / A_tank
        Explicit tank area; 1 L/m^2 == 1 mm of level.
     ===================================================================== *)

  (* P6B is a backup/bypass inlet, not an independent second supply, so the
     two inlet paths do not stack. Q_pr is the documented rate for "PR valve
     fully open"; no combined-path rate is sourced. See RESEARCH_NEEDED.md. *)
  flow_in := 0.0;
  IF pr_valve_state OR p6b_valve_state THEN
    flow_in := RW_INFLOW_LPM;
  END_IF;

  flow_out := rw_pump_flow;

  delta_level := (flow_in - flow_out) * (DT_SEC / 60.0) / RW_TANK_AREA_M2;
  rw_tank_level := rw_tank_level + delta_level;

  IF rw_tank_level < RW_TANK_MIN THEN
    rw_tank_level := RW_TANK_MIN;
  END_IF;
  IF rw_tank_level > RW_TANK_MAX THEN
    rw_tank_level := RW_TANK_MAX;
  END_IF;

  (* =====================================================================
     5. UF FEED TANK MASS BALANCE
        Receives raw water pump discharge, drawn down by the UF process.
     ===================================================================== *)

  (* Inflow only reaches the tank when the inlet valve is actually open *)
  IF ufft_valve_state THEN
    flow_in := rw_pump_flow;
  ELSE
    flow_in := 0.0;
  END_IF;

  (* Outflow is the sum of whichever outlet paths are open. During backwash the
     BWP path carries the reverse flush; the permeate side is not modelled, so
     the flush is taken from the feed tank - see Model Limitations in
     wt-p3-ultrafiltration.md. *)
  flow_out := 0.0;
  IF roft_valve_state THEN
    flow_out := flow_out + UF_ROFT_LPM;
  END_IF;
  (* The drain carries the backwash flush while the pump is running, so it
     only draws down the feed tank when used as a genuine feed-tank drain. *)
  IF drain_valve_state AND NOT bw_pump_state THEN
    flow_out := flow_out + UF_DRAIN_LPM;
  END_IF;

  delta_level := (flow_in - flow_out) * (DT_SEC / 60.0) / UFFT_TANK_AREA_M2;
  ufft_tank_level := ufft_tank_level + delta_level;

  IF ufft_tank_level < 0.0 THEN
    ufft_tank_level := 0.0;
  END_IF;
  IF ufft_tank_level > UFFT_TANK_MAX THEN
    ufft_tank_level := UFFT_TANK_MAX;
  END_IF;

  (* =====================================================================
     5b. BACKWASH TANK MASS BALANCE (P3)
        Drawn down by the backwash pump, refilled from the permeate side via
        the PT valve. The permeate source itself is not modelled - it is an
        unmodelled boundary inflow until P6 exists.
     ===================================================================== *)

  flow_in := 0.0;
  IF bw_pt_valve_state THEN
    flow_in := flow_in + BW_REFILL_LPM;
  END_IF;
  IF bw_ro_valve_state THEN
    flow_in := flow_in + BW_REFILL_LPM;
  END_IF;

  delta_level := (flow_in - bw_pump_flow) * (DT_SEC / 60.0) / BW_TANK_AREA_M2;
  bw_tank_level := bw_tank_level + delta_level;

  IF bw_tank_level < 0.0 THEN
    bw_tank_level := 0.0;
  END_IF;
  IF bw_tank_level > BW_TANK_MAX THEN
    bw_tank_level := BW_TANK_MAX;
  END_IF;

  (* =====================================================================
     5c. RO FEED TANK AND DECHLORINATION DOSING (P4)
        The RO feed tank receives UF permeate through the P3 ROFT valve and is
        drawn down by the RO feed pump toward P5. P5 is not modelled, so the
        pump discharge is an unmodelled boundary outflow.
     ===================================================================== *)

  IF roft_valve_state THEN
    flow_in := UF_ROFT_LPM;
  ELSE
    flow_in := 0.0;
  END_IF;

  delta_level := (flow_in - dc_pump_flow) * (DT_SEC / 60.0) / ROFT_TANK_AREA_M2;
  roft_tank_level := roft_tank_level + delta_level;

  IF roft_tank_level < 0.0 THEN
    roft_tank_level := 0.0;
  END_IF;
  IF roft_tank_level > ROFT_TANK_MAX THEN
    roft_tank_level := ROFT_TANK_MAX;
  END_IF;

  IF nahso3_valve_state THEN
    nahso3_level := nahso3_level - NAHSO3_DOSE_LPM * (DT_SEC / 60.0) / NAHSO3_TANK_AREA_M2;
  END_IF;
  IF nahso3_level < 0.0 THEN
    nahso3_level := 0.0;
  END_IF;
  IF nahso3_level > NAHSO3_TANK_MAX THEN
    nahso3_level := NAHSO3_TANK_MAX;
  END_IF;

  (* =====================================================================
     5d. RO PRODUCT TANK AND PERMEATE STORAGE (P5 / P6)
        Product collects from the membranes and transfers to permeate storage,
        which supplies distribution and the P3 backwash tank.
     ===================================================================== *)

  IF ro_tank_valve_state AND (ro_tank_level > 0.0) THEN
    ro_xfer_flow := RO_XFER_LPM;
  ELSE
    ro_xfer_flow := 0.0;
  END_IF;

  delta_level := (ro_permeate_flow - ro_xfer_flow) * (DT_SEC / 60.0) / RO_TANK_AREA_M2;
  ro_tank_level := ro_tank_level + delta_level;
  IF ro_tank_level < 0.0 THEN
    ro_tank_level := 0.0;
  END_IF;
  IF ro_tank_level > RO_TANK_MAX_MM THEN
    ro_tank_level := RO_TANK_MAX_MM;
  END_IF;

  IF pt_pub_state AND (pt_tank_level > 0.0) THEN
    pt_pub_flow := PT_PUB_DEMAND_LPM;
  ELSE
    pt_pub_flow := 0.0;
  END_IF;

  flow_in := 0.0;
  IF pt_ro_valve_state THEN
    flow_in := ro_xfer_flow;
  END_IF;
  flow_out := pt_pub_flow;
  (* Permeate storage also feeds the P3 backwash tank *)
  IF bw_pt_valve_state THEN
    flow_out := flow_out + BW_REFILL_LPM;
  END_IF;

  delta_level := (flow_in - flow_out) * (DT_SEC / 60.0) / PT_TANK_AREA_M2;
  pt_tank_level := pt_tank_level + delta_level;
  IF pt_tank_level < 0.0 THEN
    pt_tank_level := 0.0;
  END_IF;
  IF pt_tank_level > PT_TANK_MAX_MM THEN
    pt_tank_level := PT_TANK_MAX_MM;
  END_IF;

  (* =====================================================================
     6. CHEMICAL TANK DRAIN (P2)
        dL/dt = -Q_dose when the dosing valve is open, saturated at [0, max].
        Same implicit area normalisation as the raw water tank, per
        wt-p2-chemical-treatment.md.
     ===================================================================== *)

  IF nacl_valve_state THEN
    nacl_level := nacl_level - NACL_DOSE_LPM * (DT_SEC / 60.0) / CHEM_TANK_AREA_M2;
  END_IF;
  IF nacl_level < 0.0 THEN
    nacl_level := 0.0;
  END_IF;
  IF nacl_level > CHEM_TANK_MAX THEN
    nacl_level := CHEM_TANK_MAX;
  END_IF;

  IF naocl_valve_state THEN
    naocl_level := naocl_level - NAOCL_DOSE_LPM * (DT_SEC / 60.0) / CHEM_TANK_AREA_M2;
  END_IF;
  IF naocl_level < 0.0 THEN
    naocl_level := 0.0;
  END_IF;
  IF naocl_level > CHEM_TANK_MAX THEN
    naocl_level := CHEM_TANK_MAX;
  END_IF;

  IF hcl_valve_state THEN
    hcl_level := hcl_level - HCL_DOSE_LPM * (DT_SEC / 60.0) / CHEM_TANK_AREA_M2;
  END_IF;
  IF hcl_level < 0.0 THEN
    hcl_level := 0.0;
  END_IF;
  IF hcl_level > CHEM_TANK_MAX THEN
    hcl_level := CHEM_TANK_MAX;
  END_IF;

  (* =====================================================================
     6b. WATER QUALITY (P2 dosing -> P4 dechlorination -> P5 membranes)
     ===================================================================== *)

  (* P2: each dosing valve drives its analyte toward source + full-dose gain *)
  IF naocl_valve_state THEN
    wq_target := WQ_SRC_CL + WQ_NAOCL_GAIN;
  ELSE
    wq_target := WQ_SRC_CL;
  END_IF;
  wq_cl := wq_cl + (wq_target - wq_cl) * WQ_MIX_RATE;

  IF hcl_valve_state THEN
    wq_target := WQ_SRC_PH - WQ_HCL_GAIN;
  ELSE
    wq_target := WQ_SRC_PH;
  END_IF;
  wq_ph := wq_ph + (wq_target - wq_ph) * WQ_MIX_RATE;

  IF nacl_valve_state THEN
    wq_target := WQ_SRC_COND + WQ_NACL_GAIN;
  ELSE
    wq_target := WQ_SRC_COND;
  END_IF;
  wq_cond := wq_cond + (wq_target - wq_cond) * WQ_MIX_RATE;

  wq_hard := WQ_SRC_HARD;

  (* P4: bisulfite strips free chlorine. UF (P3) does not change dissolved
     species, so the chlorine arriving here is what P2 dosed. *)
  IF nahso3_valve_state THEN
    wq_target := wq_cl - WQ_NAHSO3_GAIN;
  ELSE
    wq_target := wq_cl;
  END_IF;
  IF wq_target < 0.0 THEN
    wq_target := 0.0;
  END_IF;
  wq_roft_cl := wq_roft_cl + (wq_target - wq_roft_cl) * WQ_MIX_RATE;

  (* P5: chlorine above the membrane tolerance degrades rejection, permanently *)
  (* Damage in proportion to the excess over tolerance, not a flat rate *)
  IF wq_roft_cl > WQ_RO_CL_MAX THEN
    membrane_damage := membrane_damage
                       + WQ_DAMAGE_RATE * (wq_roft_cl - WQ_RO_CL_MAX);
  END_IF;
  IF membrane_damage > 1.0 THEN
    membrane_damage := 1.0;
  END_IF;

  eff_rejection := WQ_RO_REJECTION * (1.0 - membrane_damage);
  IF eff_rejection < 0.0 THEN
    eff_rejection := 0.0;
  END_IF;
  wq_perm_cond := wq_cond * (1.0 - eff_rejection);
  (* AIT504 is a 0.02-20 uS/cm instrument. A real transmitter pegs at its range
     limit rather than reporting a number it cannot measure; a pegged reading is
     itself the signal that the membranes have failed. *)
  IF wq_perm_cond > 20.0 THEN
    wq_perm_cond := 20.0;
  END_IF;
  IF wq_perm_cond < 0.02 THEN
    wq_perm_cond := 0.02;
  END_IF;

  (* =====================================================================
     7. OUTPUT UPDATES
     ===================================================================== *)

  out_RW_Tank_Level := rw_tank_level;
  out_RW_Pump_Flow := rw_pump_flow;
  out_ChemTreat_NaCl_Level := nacl_level;
  out_ChemTreat_NaOCl_Level := naocl_level;
  out_ChemTreat_HCl_Level := hcl_level;
  out_UF_UFFT_Tank_Level := ufft_tank_level;

  out_RW_Tank_PR_Valve_Sts := pr_valve_state;
  out_RW_Tank_P6B_Valve_Sts := p6b_valve_state;
  out_RW_Tank_P_Valve_Sts := p_valve_state;
  out_RW_Pump_Sts := pump_state;
  out_RW_Pump_Fault := FALSE;

  (* P2 valve status reflects actual modelled position, not the command *)
  out_ChemTreat_NaCl_Valve_Sts := nacl_valve_state;
  out_ChemTreat_NaOCl_Valve_Sts := naocl_valve_state;
  out_ChemTreat_HCl_Valve_Sts := hcl_valve_state;

  (* P3 valve status reflects actual modelled position *)
  out_UF_UFFT_Tank_Valve_Sts := ufft_valve_state;
  out_UF_Drain_Valve_Sts := drain_valve_state;
  out_UF_ROFT_Valve_Sts := roft_valve_state;
  out_UF_BWP_Valve_Sts := bwp_valve_state;

  out_UF_BW_Tank_Level := bw_tank_level;
  out_UF_BW_Pump_Flow := bw_pump_flow;
  out_UF_BW_Pump_Sts := bw_pump_state;
  out_UF_BW_Pump_Fault := FALSE;
  out_UF_BW_Tank_RO_Valve_Sts := bw_ro_valve_state;
  out_UF_BW_Tank_PT_Valve_Sts := bw_pt_valve_state;

  out_DC_ROFT_Tank_Level := roft_tank_level;
  out_DC_RO_Pump_Flow := dc_pump_flow;
  out_DC_NaHSO3_Level := nahso3_level;
  out_DC_ROFT_Tank_Valve_Sts := roft_valve_p4_state;
  out_DC_RO_Pump_Sts := dc_pump_state;
  out_DC_RO_Pump_Fault := FALSE;
  out_DC_UV_Sts := uv_state;
  out_DC_NaHSO3_Valve_Sts := nahso3_valve_state;

  out_RO_Tank_Level := ro_tank_level;
  out_RO_Pump_Flow := ro_pump_flow;
  out_RO_CF_A_Valve_Sts := cf_a_state;
  out_RO_CF_B_Valve_Sts := cf_b_state;
  out_RO_Pump_Sts := ro_pump_state;
  out_RO_Pump_Fault := FALSE;
  out_RO_Tank_Valve_Sts := ro_tank_valve_state;

  out_PT_Tank_Level := pt_tank_level;
  out_PT_RO_Valve_Sts := pt_ro_valve_state;
  out_PT_PUB_Sts := pt_pub_state;

  (* Analyser outputs. ORP is mapped linearly from free chlorine: an oxidising
     residual reads high, a reduced (dechlorinated) stream reads low. The
     mapping is SPHERE-original - the instrument range is sourced, the
     chlorine-to-ORP transfer is not. *)
  out_ChemTreat_Conductivity := wq_cond;
  out_ChemTreat_pH := wq_ph;
  out_ChemTreat_ORP := 200.0 + 400.0 * wq_cl;
  out_DC_Hardness := wq_hard;
  out_DC_ORP := 200.0 + 400.0 * wq_roft_cl;
  out_RO_Feed_pH := wq_ph;
  out_RO_Feed_ORP := 200.0 + 400.0 * wq_roft_cl;
  out_RO_Feed_Conductivity := wq_cond;
  out_RO_Permeate_Conductivity := wq_perm_cond;

END_PROGRAM

CONFIGURATION Config0
  RESOURCE Res0 ON PLC
    TASK Main(INTERVAL := T#100ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Main : WaterTreatmentSimulator;
  END_RESOURCE
END_CONFIGURATION
