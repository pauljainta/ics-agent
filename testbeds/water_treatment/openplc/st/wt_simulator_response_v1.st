    (* --- Water quality state ---
       Concentrations are carried stage to stage. Dosing moves a stream toward
       its target with a first-order blend; dechlorination subtracts reducing
       capacity; the membranes reject salt.

       EXPERIMENTAL MODEL, not physically validated: free chlorine above a
       configured RO-feed threshold accumulates an irreversible state variable,
       reducing modeled salt rejection and raising modeled AIT504 conductivity.
       The threshold and rate are simulation parameters, not vendor limits. *)
    fixture_apply_prev : BOOL := FALSE;
    WQ_SRC_CL : REAL := 0.0;
    WQ_SRC_PH : REAL := 7.5;
    WQ_SRC_COND : REAL := 300.0;
    WQ_SRC_HARD : REAL := 5.0;
    WQ_NAOCL_GAIN : REAL := 1.0;
    WQ_HCL_GAIN : REAL := 0.8;
