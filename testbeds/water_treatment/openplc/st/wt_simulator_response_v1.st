    RW_TANK_AREA_M2 : REAL := 12.0;    (* research default, range 8-60 m^2 *)
    UFFT_TANK_AREA_M2 : REAL := 6.0;   (* research default, range 0.5-12 m^2 *)
    CHEM_TANK_AREA_M2 : REAL := 0.114; (* 114 L day tank over 1000 mm *)

