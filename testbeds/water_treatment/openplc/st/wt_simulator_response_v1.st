    (* --- P3 ultrafiltration (wt-p3-ultrafiltration.md) ---
       Drain and ROFT flows are the documented SPHERE estimate. The physically
       correct basis is flux x membrane area, but no membrane module has been
       chosen, so area stays OPEN in RESEARCH_NEEDED.md and the estimate holds.
       Backwash flow is scaled by the researched flux ratio 150/70 LMH. *)
    UFFT_TANK_MAX : REAL := 1200.0;   (* [mm] *)
    UF_ROFT_LPM : REAL := 30.0;       (* permeate to RO feed tank, estimate *)
    UF_DRAIN_LPM : REAL := 30.0;      (* waste drain, estimate *)
    UF_BACKWASH_LPM : REAL := 64.3;   (* 30 * (150/70) backwash flux ratio *)

    (* --- Backwash tank and pump (FDS 4.2) ---
       The FDS defines the tank and pump but gives no dimensions, so the area
       and refill rate are SPHERE choices, recorded in RESEARCH_NEEDED.md:
         area   0.3 m^2  -> one 60 s backwash draws ~214 mm of a 1000 mm tank
         refill 3.0 L/min -> replaces a cycle's 64 L within the 30 min interval
       Refill is drawn from the permeate side, which is not modelled here; the
       PT valve is therefore an unmodelled boundary inflow. *)
    BW_TANK_AREA_M2 : REAL := 0.3;
    BW_TANK_MAX : REAL := 1000.0;
    BW_REFILL_LPM : REAL := 3.0;
    BW_PUMP_Q_MAX : REAL := 64.3;     (* at 100% speed, matches the flush rate *)

    (* --- P4 dechlorination ---
       The FDS names the RO feed tank, RO feed pump, UV lamp and bisulfite
       tank but gives no dimensions or ratings. ROFT area reuses the UF feed
       tank's researched class (0.5-12 m^2, default 6). The bisulfite tank is
       treated as a day tank like the P2 chemicals (114 L over 1000 mm), and
       dosed at the same 1 GPH metering-pump class. RO pump rating is a SPHERE
       choice sized just above the UF permeate feed so the tank can be drawn
       down. All recorded in RESEARCH_NEEDED.md. *)
    ROFT_TANK_AREA_M2 : REAL := 6.0;
    ROFT_TANK_MAX : REAL := 1200.0;
    (* Sized above the 30 L/min UF permeate feed so the tank can be drawn
       down; at the 75% setpoint that is 45 L/min, a 50% margin. A pump
       rated at the feed rate would exactly cancel inflow and stall. *)
    DC_RO_PUMP_Q_MAX : REAL := 60.0;  (* [L/min] at 100% speed *)
    NAHSO3_TANK_AREA_M2 : REAL := 0.114;
    NAHSO3_TANK_MAX : REAL := 1000.0;
    NAHSO3_DOSE_LPM : REAL := 0.063;  (* 1 GPH metering pump class *)
    UV_WARMUP_SCANS : INT := 30;      (* 3 s lamp strike, SPHERE estimate *)

    (* --- P5 reverse osmosis / P6 permeate storage ---
       RO recovery is the permeate fraction of feed; the rest leaves as
       concentrate, which the FDS does not instrument and this model does not
       track. 50% is a conservative figure within the usual brackish-water
       band but is not sourced for this plant. Tank areas and the distribution
       demand are SPHERE choices - see RESEARCH_NEEDED.md. *)
    RO_RECOVERY : REAL := 0.5;
    RO_TANK_AREA_M2 : REAL := 6.0;
    RO_TANK_MAX_MM : REAL := 1200.0;
    RO_PUMP_Q_MAX : REAL := 45.0;     (* HP pump feed rate [L/min] *)
    (* Transfer must be meaningfully above the permeate rate (0.5 x 45 x 80%
       = 18 L/min) or the product tank cannot draw down between cycles. *)
    RO_XFER_LPM : REAL := 30.0;       (* product transfer to permeate storage *)
    PT_TANK_AREA_M2 : REAL := 10.0;
    PT_TANK_MAX_MM : REAL := 1500.0;
    PT_PUB_DEMAND_LPM : REAL := 12.0; (* distribution draw when PUB valve open *)

    (* --- P2 chemical dosing (wt-p2-chemical-treatment.md) ---
