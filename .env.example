# Local model settings
ICS_AGENT_MODEL_ID=Qwen/Qwen3.5-9B
ICS_AGENT_MODEL_PATH=./models/local_models/qwen3.5-9b
QWEN_MODEL_ID=Qwen/Qwen3.5-9B
QWEN_MODEL_PATH=./models/local_models/qwen3.5-9b
MODEL_CACHE_DIR=./.cache/models
QWEN_DEVICE=auto
QWEN_PRECISION=auto

# SPHERE runtime profile. Copy `configs/infrastructure/sphere.example.yaml` to
# `configs/private/sphere.local.yaml` and fill in the active reservation values.
ICS_AGENT_SPHERE_CONFIG=configs/private/sphere.local.yaml
ICS_AGENT_SPHERE_XDC_OVERRIDE=
ICS_AGENT_ALLOW_XDC_DISCOVERY=0

# Runtime options
READ_ONLY=true
LOG_LEVEL=INFO
